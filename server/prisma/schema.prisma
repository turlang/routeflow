generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  addresses    Address[]
  deliveries   Delivery[]
  routes       Route[]
}

model Address {
  id             String   @id @default(cuid())
  userId         String
  normalizedKey  String
  address        String
  latitude       Float?
  longitude      Float?
  type           String   @default("Casa")
  hours          String?
  access         String?
  parking        String?
  notes          String?
  importCount    Int      @default(1)
  lastImportedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries     Delivery[]

  @@unique([userId, normalizedKey])
  @@index([userId, updatedAt])
}

model Route {
  id              String     @id @default(cuid())
  userId          String
  clientId        String?
  sourceFilename  String?
  status          String     @default("PLANNED")
  startedAt       DateTime?
  finishedAt      DateTime?
  plannedKm       Float?
  plannedMinutes  Int?
  stops           Int?
  deliveriesCount Int?
  completedStops  Int        @default(0)
  operational     Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries      Delivery[]

  @@unique([userId, clientId])
  @@index([userId, createdAt])
}

model Delivery {
  id            String   @id @default(cuid())
  userId        String
  clientId      String?
  routeId       String?
  addressId     String?
  packageNo     String?
  size          String?
  status        String   @default("PENDING")
  deliveredAt   DateTime?
  latitude      Float?
  longitude     Float?
  accuracy      Float?
  notes         String?
  failureReason String?
  recipientName String?
  proofPhotoUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  route         Route?   @relation(fields: [routeId], references: [id], onDelete: SetNull)
  address       Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  @@unique([userId, clientId])
  @@index([userId, deliveredAt])
  @@index([routeId, status])
}
