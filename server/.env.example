PORT=3001
DATABASE_URL="postgresql://routeflow:routeflow@localhost:5432/routeflow?schema=public"
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
CORS_ORIGIN="http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500,https://turlang.github.io"
ADMIN_EMAILS=""

ROUTING_BASE_URL="https://router.project-osrm.org"
ROUTING_TIMEOUT_MS=12000

STORAGE_PROVIDER=""
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Cartão recorrente: Asaas. priceCents do plano representa o preço-base/Pix.
ASAAS_API_KEY=""
ASAAS_ENVIRONMENT="sandbox"
ASAAS_WEBHOOK_TOKEN=""
ASAAS_WEBHOOK_URL=""
# Encargos usados para formar o preço de cartão sem reduzir o preço-base líquido desejado.
# Configure com as condições comerciais efetivas da conta Asaas antes de produção.
ASAAS_CARD_FEE_PERCENT=0
ASAAS_CARD_FIXED_FEE_CENTS=0

# Pix: Banco Inter Empresas. O Pix é recebido na conta empresarial vinculada à integração.
INTER_ENVIRONMENT="sandbox"
INTER_CLIENT_ID=""
INTER_CLIENT_SECRET=""
# Pode ser caminho de arquivo seguro ou PEM injetado por secret (\\n é aceito).
INTER_CERTIFICATE=""
INTER_PRIVATE_KEY=""
INTER_PIX_KEY=""
# Necessário quando a integração estiver associada a mais de uma conta.
INTER_ACCOUNT=""
INTER_SCOPES="cob.write cob.read pix.read webhook.read webhook.write"

# Adaptador legado, mantido apenas por compatibilidade.
BILLING_PROVIDER=""
BILLING_WEBHOOK_SECRET=""
BILLING_API_KEY=""
